{
	"schemaVersion": 1,
	"id": "beaconrange",
	"version": "${version}",
	"name": "Beacon Range",
	"description": "Look at a beacon to see exactly where its effects reach. Pin beacons to keep their range visible - saved per world.",
	"authors": [
		"kclucas"
	],
	"contact": {
		"sources": "https://github.com/KCLucas/BeaconRange",
		"issues": "https://github.com/KCLucas/BeaconRange/issues"
	},
	"license": "MIT",
	"icon": "assets/beaconrange/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.kclucas.beaconrange.client.BeaconRangeClient"
		],
		"modmenu": [
			"com.kclucas.beaconrange.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"beaconrange.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
